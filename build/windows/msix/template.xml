<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="go-ssh-ui"
        Arguments=""
        InstallLocation="C:\Program Files\My Company\go-ssh-ui">
    </Installer>
    <PackageInformation
        PackageName="go-ssh-ui"
        PackageDisplayName="go-ssh-ui"
        PublisherName="CN=My Company"
        PublisherDisplayName="My Company"
        Version="0.1.0.0"
        PackageDescription="Masaustu SSH host yoneticisi ve terminal istemcisi">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.buraktanriverdi.gosshui"
                Description="Masaustu SSH host yoneticisi ve terminal istemcisi"
                DisplayName="go-ssh-ui"
                ExecutableName="go-ssh-ui"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>go-ssh-ui</DisplayName>
            <PublisherDisplayName>My Company</PublisherDisplayName>
            <Description>Masaustu SSH host yoneticisi ve terminal istemcisi</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="go-ssh-ui.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
